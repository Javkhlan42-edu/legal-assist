{
  "name": "@legal-chatbot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "ingest": "tsx src/index.ts ingest --all",
    "ingest:shuukh": "tsx src/index.ts ingest --source shuukh",
    "ingest:legalinfo": "tsx src/index.ts ingest --source legalinfo",
    "ingest:local": "tsx src/jobs/ingest-local.ts",
    "ingest:seed": "tsx src/jobs/ingest-from-seed.ts",
    "ingest:seed-priority": "tsx src/jobs/ingest-from-seed.ts --legalinfo-seed legalinfo_priority_urls.txt --legalinfo-only",
    "ingest:seed-local": "tsx src/jobs/ingest-seed-local.ts",
    "seed:priority:refresh": "tsx src/scripts/generate-priority-seed.ts",
    "verify:vector": "tsx src/scripts/verify-vector.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "index:embed": "tsx src/scripts/07_embed_and_index.ts",
    "reembed:db": "tsx src/scripts/reembed-chunks-from-db.ts"
  },
  "dependencies": {
    "@legal-chatbot/shared": "workspace:*",
    "@xenova/transformers": "^2.17.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0-rc.12",
    "chromadb": "^1.8.1",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "node-cron": "^3.0.3",
    "openai": "^4.28.0",
    "pg": "^8.20.0",
    "pino": "^8.18.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
