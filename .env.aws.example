# AWS/EC2 production env for docker/docker-compose.aws.yml
# Copy this content into the GitHub Actions secret named PRODUCTION_ENV.

NODE_ENV=production
LOG_LEVEL=info

# Public URL users open in the browser. If you do not have a domain yet, use:
# Include the production domain, optional www domain, and the public ALB HTTP URL while smoke testing.
# Example: CORS_ORIGIN=https://hop-on.dev,https://www.hop-on.dev,http://hop-on.dev,http://www.hop-on.dev,http://legal-assist-alb-xxxx.ap-southeast-1.elb.amazonaws.com
CORS_ORIGIN=http://YOUR_DOMAIN_OR_ALB_DNS
NEXT_PUBLIC_API_URL=
PUBLIC_HTTP_PORT=80

# Database
DB_PASSWORD=change-this-to-a-long-random-password

# OpenAI
OPENAI_API_KEY=sk-your-production-key
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=3072

# Retrieval/answer quality
OPENAI_TIMEOUT_MS=180000
RETRIEVAL_SPEED_MODE=quality
INCLUDE_RELATED_CASES=auto
RETRIEVAL_TIMEOUT_MS=180000
GENERATION_TIMEOUT_MS=180000
RESPONSE_LATENCY_BUDGET_MS=240000
USE_CROSS_RERANKER=false

# Auth
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters
GOOGLE_CLIENT_ID=

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Worker safety
PIPELINE_FAIL_FAST=false
PIPELINE_MAX_CONSECUTIVE_FAILURES=20
CRAWL_DELAY_MS=1000
CRAWL_MAX_CONCURRENT=1
