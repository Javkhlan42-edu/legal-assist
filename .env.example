# ── General ──
NODE_ENV=development
LOG_LEVEL=debug

# ── API ──
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# ── Web ──
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/legal_chatbot

# ── Vector DB ──
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_FALLBACK=false
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=mn_legal_rag

# ── LLM Provider ──
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
OPENAI_TIMEOUT_MS=180000
RETRIEVAL_SPEED_MODE=balanced
INCLUDE_RELATED_CASES=auto
RETRIEVAL_TIMEOUT_MS=180000
GENERATION_TIMEOUT_MS=180000
RESPONSE_LATENCY_BUDGET_MS=240000
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_MIN_QUALITY=0.55
RETRIEVAL_CACHE_VERSION=retrieval-context-v1
USE_CROSS_RERANKER=false
CROSS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CROSS_RERANKER_TOP_N=20
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=4
EMBEDDING_RETRY_BASE_MS=1000

# ── Chunking ──
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ── Worker ──
CRAWL_DELAY_MS=1000
CRAWL_MAX_CONCURRENT=1
SHUUKH_MAX_DISCOVERY_PAGES=300
CRAWL_CACHE_DIR=./data/cache
CRAWL_USER_AGENT=LegalRAGBot/0.1
SHUUKH_COURT_CATEGORIES=2,1
SHUUKH_RECENT_MONTHS=4
SHUUKH_BB=1
SHUUKH_TOPIC_KEYWORDS_CIVIL=зам тээвэр,даатгал,осол,гэрээ,зээл,хөдөлмөр,нөхөн төлбөр
SHUUKH_TOPIC_KEYWORDS_CRIMINAL=хулгай,залилан,хүчирхийлэл,мансууруулах,осол,авлига

# ── Pipeline Reliability ──
PIPELINE_FAIL_FAST=false
PIPELINE_MAX_ERROR_RATE=0.30
PIPELINE_MAX_CONSECUTIVE_FAILURES=20
PIPELINE_MAX_RETRIES_PER_DOC=3
PIPELINE_RETRY_BASE_MS=750
PIPELINE_MIN_HTML_LENGTH=120
PIPELINE_MIN_TEXT_LENGTH=120
PIPELINE_DEAD_LETTER_DIR=data/processed/dead-letter

# ── Auth (optional) ──
API_KEY_SECRET=change-me-in-production
